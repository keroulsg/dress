# ==============================================================================
# Maison Rentale — Production Environment Blueprint
# Copy this file to .env on production servers: cp .env.production.example .env
# ==============================================================================

# Core Application Settings
APP_NAME="Maison Rentale"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_USING_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=https://maisonrentale.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Production Database (PostgreSQL / MySQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maisonrentale_prod
DB_USERNAME=maison_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Production High-Speed Cache, Sessions & Queues via Redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.maisonrentale.com
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_REDIS_SECURE_AUTH_PASSWORD
REDIS_PORT=6379

# Cloud Object Storage (AWS S3 / Cloudflare R2 for Dress Photos & Secure KYC)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_CLOUDFLARE_R2_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_CLOUDFLARE_R2_SECRET
AWS_DEFAULT_REGION=auto
AWS_BUCKET=maison-rentale-production
AWS_URL=https://cdn.maisonrentale.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment Gateway (Live Paymob Egypt Integration)
PAYMENT_GATEWAY=paymob
PAYMOB_API_KEY=YOUR_LIVE_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_INTEGRATION_ID_WALLET=123457
PAYMOB_IFRAME_ID=789012
PAYMOB_HMAC_SECRET=YOUR_LIVE_PAYMOB_HMAC_SECRET_KEY
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Transactional Mail (SMTP via Postmark / Amazon SES / Resend)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_POSTMARK_API_TOKEN
MAIL_PASSWORD=YOUR_POSTMARK_API_TOKEN
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="concierge@maisonrentale.com"
MAIL_FROM_NAME="Maison Rentale Concierge"

# WhatsApp Business API / SMS Alerts (Optional Gateway)
WHATSAPP_API_TOKEN=YOUR_WHATSAPP_BUSINESS_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
